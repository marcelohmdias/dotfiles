#!/usr/bin/env bash

set -euo pipefail

AI_CLI_TOOLS=(
  claude
  codex
  copilot
  crush
  gemini
  opencode
)

chosen=$(printf '%s\n' "${AI_CLI_TOOLS[@]}" | fzf --border-label ' 󰚩 AI Tools ')

[[ -z ${chosen:-} ]] && exit 0

case "$chosen" in
  copilot)  exec copilot --banner ;;
  *)        exec "$chosen" ;;
esac
