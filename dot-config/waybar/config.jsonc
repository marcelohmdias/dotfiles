{
	"reload_style_on_change": true,
	"layer": "top",
	"position": "top",
	"spacing": 0,
	"height": 32,
	"margin-top": 8,
	"margin-left": 8,
	"margin-right": 8,
	"include": [
		"~/.config/waybar/modules.jsonc",
		"~/.config/waybar/groups.jsonc"
	],
	"modules-left": ["group/starter", "hyprland/window"],
	"modules-center": ["group/clock"],
	"modules-right": ["group/play", "group/processors", "group/alerts"]
}
