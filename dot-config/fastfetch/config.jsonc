//
// ░█▀▀░█▀█░█▀▀░▀█▀░█▀▀░█▀▀░▀█▀░█▀▀░█░█░
// ░█▀▀░█▀█░▀▀█░░█░░█▀▀░█▀▀░░█░░█░░░█▀█░
// ░▀░░░▀░▀░▀▀▀░░▀░░▀░░░▀▀▀░░▀░░▀▀▀░▀░▀░
//
// A neofetch like system information tool
// https://github.com/fastfetch-cli/fastfetch

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "left": 2,
      "right": 2,
      "top": 2,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    {
      "key": "╭─────────────────────  Hardware  ─────────────────────╮",
      "type": "custom",
    },
    {
      "key": "  󰇄   Model     ",
      "type": "host",
      "format": "{}",
    },
    {
      "key": "     CPU       ",
      "type": "cpu",
      "format": "{}",
    },
    {
      "key": "     GPU       ",
      "type": "gpu",
      "format": "{2}",
      "hideType": "integrated",
    },
    {
      "key": "  󰹑   Resolution",
      "type": "display",
      "compactType": "original",
    },
    {
      "key": "  󰋊   Disk      ",
      "type": "disk",
      "format": "{1} / {2} ({3})",
    },
    {
      "key": "     Memory    ",
      "type": "memory",
      "format": "{1} / {2} ({3})",
    },
    {
      "key": "  󰯍   Swap      ",
      "type": "swap",
      "format": "{1} / {2} ({3})",
    },
    {
      "key": "  󰈀   Rede      ",
      "type": "localip",
      "format": "{1}",
    },
    {
      "key": "╰──────────────────────────────────────────────────────╯",
      "type": "custom",
    },
    {
      "key": "╭─────────────────────  Software  ─────────────────────╮",
      "type": "custom",
    },
    {
      "key": "     OS        ",
      "type": "command",
      "text": "{}",
    },
    {
      "key": "     Kernel    ",
      "type": "kernel",
      "format": "{1} {2}",
    },
    {
      "key": "     WM        ",
      "type": "wm",
      "format": "{2} ({3})",
    },
    {
      "key": "     Packages  ",
      "type": "packages",
      "format": "{brew} (brew), {flatpak-user} (flatpak)",
    },
    {
      "key": "     DE        ",
      "type": "de",
      "slowVersionDetection": true,
    },
    {
      "key": "     Shell     ",
      "type": "shell",
      "format": "{1} v{4}",
    },
    {
      "key": "     Terminal  ",
      "type": "terminal",
      "format": "{5} v{6}",
    },
    {
      "key": "     Font      ",
      "type": "terminalfont",
      "format": "{2}",
    },
    {
      "key": "     Theme       ",
      "type": "theme",
    },
    {
      "key": "     Icons     ",
      "type": "icons",
    },
    {
      "key": "  󰔚   Uptime    ",
      "type": "uptime",
      "format": "{}d {}h {}m",
    },
    {
      "key": "╰──────────────────────────────────────────────────────╯",
      "type": "custom",
    },
    "break",
    {
      "type": "colors",
      "block": {
        "width": 7,
      },
    },
    "break",
  ],
}
