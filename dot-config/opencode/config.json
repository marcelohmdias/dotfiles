{
	"$schema": "https://opencode.ai/config.json",

	"mcp": {
		"browsermcp": {
			"type": "local",
			"command": ["bunx", "--bun", "@browsermcp/mcp@latest"],
			"enabled": false
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
			},
			"enabled": true
		},
		"playwright": {
			"type": "local",
			"command": ["bunx", "--bun", "@playwright/mcp@latest"],
			"enabled": true
		},
		"MCP_DOCKER": {
			"type": "local",
			"command": ["docker", "mcp", "gateway", "run"],
			"enabled": false
		},
		"TestSprite": {
			"type": "local",
			"command": ["bunx", "--bun", "@testsprite/testsprite-mcp@latest"],
			"environment": {
				"API_KEY": "{env.TESTSPRITE_API_KEY}"
			},
			"enabled": false
		}
	}
}
